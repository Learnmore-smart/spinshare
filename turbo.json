{
  "ui": "stream",
  "globalEnv": [
    "SPINSHARE_MODE",
    "FIRESTORE_EMULATOR_HOST",
    "SPINSHARE_REDIS",
    "STRIPE_MODE",
    "AUTH_MODE"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "out/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "lint": {
      "dependsOn": ["^build"]
    }
  }
}
