{
  "name": "@spinshare/cli",
  "version": "0.1.0",
  "description": "SpinShare CLI wrapper — spawns a target command, intercepts its spinner output, renders ad text, and reports impressions.",
  "type": "module",
  "bin": {
    "spinshare": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --passWithNoTests",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@homebridge/node-pty-prebuilt-multiarch": "^0.13.1"
  },
  "optionalDependencies": {
    "keytar": "^7.9.0"
  },
  "devDependencies": {
    "@spinshare/core": "workspace:*",
    "@types/node": "^22.5.0",
    "fast-check": "^3.22.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
