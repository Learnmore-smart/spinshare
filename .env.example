# SpinShare environment template.
# Copy to .env for local use, or map these names to your production secrets.
# Never commit real secret values.

# App mode
SPINSHARE_MODE=local
SPINSHARE_COUNTER=memory

# Public app URLs
NEXTAUTH_URL=http://localhost:3000
AUTH_VERIFICATION_URI=http://localhost:3000/activate
SPINSHARE_BASE_URL=http://localhost:3000
SPINSHARE_API_URL=http://localhost:3000

# Auth.js / NextAuth
AUTH_MODE=mock
AUTH_SECRET=replace-with-at-least-32-random-bytes

# OAuth providers, required when AUTH_MODE=oauth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_ID=
GITHUB_SECRET=

# Firebase Admin SDK / production data stores
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=

# Local Firestore emulator only
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Stripe
STRIPE_MODE=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# CLI/dev overrides
SPINSHARE_TOKEN=
