# SpinShare environment template.
# Copy to repo-root `.env` only. Next.js loads it via web/next.config.mjs (no web/.env).
# Never commit real secret values.
#
# ─────────────────────────────────────────────────────────────────────────────
# ARCHIVED MODE — most variables below are NOT needed for the public portfolio.
# ─────────────────────────────────────────────────────────────────────────────
# SpinShare is currently archived (see web/src/middleware.ts: ARCHIVED = true).
# All payment, auth, bidding, and tracking routes are blocked at the edge by
# middleware and return 410 Gone. Only the landing page, /privacy, /terms,
# /api/health, and static assets are served.
#
# To deploy the archived site on Vercel, you only need TWO env vars:
#   SPINSHARE_BASE_URL  — your Vercel URL (e.g. https://your-project.vercel.app)
#   AUTH_SECRET         — any random 32+ byte string (dummy is fine; routes are blocked)
#
# To RE-ENABLE the live marketplace in the future:
#   1. Set ARCHIVED = false in web/src/middleware.ts
#   2. Fill in the real values for every section below.
#   3. Redeploy.
# ─────────────────────────────────────────────────────────────────────────────

# App mode
SPINSHARE_MODE=local
SPINSHARE_COUNTER=memory
# Optional RTDB hot-counter root override. Local RTDB defaults to
# spinshare/namespaces/<SPINSHARE_FIRESTORE_NAMESPACE-or-local>/hot.
# SPINSHARE_RTDB_ROOT_PATH=spinshare/staging/hot

# Google Analytics 4 (optional; omit locally to skip gtag.js)
# NOTE: The archived site does NOT render <GoogleAnalytics /> — this is unused.
# Set only if you re-enable analytics after un-archiving.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Public app URLs
NEXTAUTH_URL=http://localhost:3000
AUTH_VERIFICATION_URI=http://localhost:3000/activate
SPINSHARE_BASE_URL=http://localhost:3000
SPINSHARE_API_URL=http://localhost:3000

# Auth.js / NextAuth
AUTH_MODE=mock
AUTH_SECRET=replace-with-at-least-32-random-bytes

# OAuth providers, required when AUTH_MODE=oauth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_ID=
GITHUB_SECRET=

# Firebase Admin SDK / production data stores
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=

# Local Firestore emulator only
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Local cloud Firestore isolation. When SPINSHARE_USE_FIRESTORE=1 is set for
# localhost, set this to avoid writing top-level production collections.
# SPINSHARE_FIRESTORE_NAMESPACE=test

# Optional local demo seed. Leave unset while testing payments/leaderboards.
# SPINSHARE_SEED_LOCAL_DATA=1

# Stripe
STRIPE_MODE=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# CLI/dev overrides
SPINSHARE_TOKEN=
