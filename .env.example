# SpinShare configuration
# Copy to `.env` and adjust. Local/dev/test defaults run the full money path
# with zero external credentials. See design.md "Configuration switch".

# Composition-root mode. Selects provider adapters at startup.
#   "local"      -> credential-free adapters (default for dev/test/e2e)
#   "production" -> real Firestore + Upstash Redis + Stripe + OAuth
SPINSHARE_MODE=local

# Firestore emulator host. When set, the real Firestore client targets the
# local emulator instead of Google Cloud. Used in local mode and the e2e test.
# Leave unset in production to use managed Firestore.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Redis (hot-path counter store) selection.
#   "memory"       -> in-process MemoryCounterStore (default, no dependency)
#   "ioredis-mock" -> ioredis-mock backed store
#   <upstash url>  -> Upstash Redis REST URL in production
SPINSHARE_REDIS=memory

# Stripe payment gateway mode.
#   "mock" -> MockPaymentGateway with deterministic, locally-signed events
#   "test" -> Stripe test mode
#   "live" -> Stripe live mode (production)
STRIPE_MODE=mock

# Authentication mode.
#   "mock"  -> MockAuthProvider (mints local Device_Auth_Tokens, no real IdP)
#   "oauth" -> NextAuth with Google + GitHub providers
AUTH_MODE=mock

# OAuth / NextAuth settings (only needed when AUTH_MODE=oauth).
# AUTH_SECRET signs both NextAuth sessions and the stateless Device_Auth_Tokens;
# it MUST be set in production. Locally a dev fallback is used if unset.
# AUTH_SECRET=replace-with-a-long-random-string
# Google OAuth client credentials.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GitHub OAuth app credentials.
# GITHUB_ID=
# GITHUB_SECRET=
# Browser activation URL for the device flow (defaults to <NEXTAUTH_URL>/activate
# or https://spinshare.dev/activate).
# AUTH_VERIFICATION_URI=
# NEXTAUTH_URL=http://localhost:3000
